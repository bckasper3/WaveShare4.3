# Target: ESP32-S3-WROOM-1-N16R8 (16 MB QIO flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# RGB panel stability from PSRAM (Waveshare 08_lvgl_Porting / wiki performance settings)
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# 1 ms tick: CH422G DI settle (2 ms), LVGL 5 ms timer
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# UART0 (GPIO43/44) is RS-485 -> keep logs off it.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# TODO: decide whether to burn eFuse UART_PRINT_CONTROL to silence ROM boot text on RS-485.

# OTA with rollback
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# FAT long file names for CSV export
CONFIG_FATFS_LFN_HEAP=y

# Datalog crash safety (docs/DATALOG.md): 512-byte wear-levelling sectors in SAFE mode, so a
# power cut during a small write cannot erase neighbouring records. Verify on the power-cut rig.
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_SAFE=y

# LVGL / RGB panel performance (see Waveshare 08_lvgl_Porting)
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Task watchdog
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# USB device mode: TinyUSB CDC-ACM (docs/USB.md). TODO: your own VID/PID before shipping devices.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="envlogger"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Environment Logger"
